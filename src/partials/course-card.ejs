<article class="course-card" itemscope itemtype="https://schema.org/Course">
  <p class="course-card__category" itemprop="about"><%= course.category %></p>
  <h3 class="course-card__title" itemprop="name"><%= course.title %></h3>
  <p class="course-card__meta"><span itemprop="educationalLevel"><%= course.level %></span> &middot; <%= course.weeks %> weeks</p>
  <p class="course-card__price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
    <meta itemprop="priceCurrency" content="EUR">
    <span itemprop="price" content="<%= course.price %>"><%= priceLabel(course.price) %></span>
  </p>
  <meta itemprop="provider" content="<%= site.name %>">
  <%- include('button', { href: './course-details.html', label: 'View course' }) %>
</article>
