<a class="skip-link" href="#main">Skip to main content</a>
<header class="header">
  <a class="header__logo" href="./index.html"><%= site.name %></a>
  <button class="header__menu" type="button" aria-label="Open menu" aria-controls="main-nav" aria-expanded="false">
    <span class="header__menu-line"></span>
    <span class="header__menu-line"></span>
    <span class="header__menu-line"></span>
  </button>
  <nav class="header__nav nav" id="main-nav" aria-label="Main navigation">
    <ul class="nav__list">
      <% site.nav.forEach(function (item) { %>
      <li class="nav__item">
        <a class="nav__link<%= active === item.key ? ' nav__link--active' : '' %>" href="<%= item.href %>"<%- active === item.key ? ' aria-current="page"' : '' %>><%= item.label %></a>
      </li>
      <% }); %>
    </ul>
  </nav>
</header>
