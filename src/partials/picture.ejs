<picture class="<%= cls %>">
  <source type="image/webp" srcset="./src/assets/images/<%= image %>-480.webp 480w, ./src/assets/images/<%= image %>-960.webp 960w" sizes="<%= sizes %>">
  <img class="<%= cls %>-img" src="./src/assets/images/<%= image %>-960.jpg" alt="<%= alt %>" width="960" height="540" loading="lazy">
</picture>
